{
  "name": "dsh-cosyvoice",
  "version": "3.0.0",
  "description": "为 DeepSeek Harness 网页界面的每条 AI 回答加一个语音播放键：点击即用阿里云百炼 CosyVoice 音色朗读该回答。V2 增加音色档案、音色克隆（上传音频自动获得音色 ID）；v2.1 提供实时（流式）与非实时（整段）两种合成方式；v3.0 增加角色扮演模式，把「」里的台词与其余旁白拆开，用两种音色分别合成后按原文顺序拼回一条音频。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "voice",
    "tts",
    "cosyvoice"
  ],
  "main": "host/index.js",
  "files": [
    "host",
    "client",
    "lib",
    "assets",
    "cordis.patch.yml",
    "build.mjs",
    "verify.mjs",
    "README.md"
  ],
  "exports": {
    ".": {
      "default": "./host/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "verify": "node verify.mjs",
    "test": "node --test \"test/*.test.mjs\" && node build.mjs && node verify.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "immediately": false
    }
  }
}
